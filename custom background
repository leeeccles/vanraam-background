/* =================== UI TIDYING =================== */

.section.logo-section.workspace-navigation-logo {
  display: none !important;
}
.nested-section.home-section {
  margin-top: 8px !important;
}
.group-pic-container .type-icon {
  display: none !important;
}


/* =================== HOMEPAGE: GRADIENT BACKGROUND =================== */
/*
  Soft top-to-bottom brand colour gradient â€” replaces the blueprint grid.
  Lighter at the top, gently deeper toward the bottom so the page feels
  grounded without any geometric pattern competing with the photo.
*/

.__view:has(#my-work-section) {
  position: relative !important;
  background: linear-gradient(
    to bottom,
    color-mix(in srgb, var(--primary-600) 2%, white) 0%,
    color-mix(in srgb, var(--primary-600) 6%, white) 100%
  ) !important;
  min-height: 100vh !important;
}


/* =================== HOMEPAGE: COLLABORATION PHOTO =================== */
/*
  Fixed background so the photo stays anchored while content scrolls â€”
  adds depth and makes it feel like part of the interface, not content.
  Opacity 0.08 keeps it barely-there; the gradient wash behind it tints
  it in the platform colour. Gradient mask softens the top/bottom edges.

  Image hosted at: https://github.com/leeeccles/lms-assets
*/

.__view:has(#my-work-section)::before {
  content: '' !important;
  position: absolute !important;
  top: 0 !important;
  left: 0 !important;
  right: 0 !important;
  height: 100% !important;
  background-image: url('https://www.vanraam.com/en-gb/our-bikes/tricycles/tricycles-for-adults/easy-rider') !important;
  background-size: 75% auto !important;
  background-position: left 70% !important;
  background-repeat: no-repeat !important;
  background-attachment: fixed !important;
  opacity: 0.10 !important;
  filter: grayscale(15%) !important;
  mask-image:
    linear-gradient(to bottom, transparent 0%, black 28%, black 60%, transparent 100%),
    linear-gradient(to right, black 30%, transparent 75%) !important;
  -webkit-mask-image:
    linear-gradient(to bottom, transparent 0%, black 28%, black 60%, transparent 100%),
    linear-gradient(to right, black 30%, transparent 75%) !important;
  mask-composite: intersect !important;
  -webkit-mask-composite: source-in !important;
  z-index: 0 !important;
  pointer-events: none !important;
}

/* Keep all content above the photo layer */
.__view:has(#my-work-section) > * {
  position: relative !important;
  z-index: 1 !important;
}


/* =================== MY WORK: SHADOW LIFT =================== */

#my-work-section {
  border-radius: 12px !important;
  box-shadow:
    0 2px 8px color-mix(in srgb, var(--primary-600) 8%, transparent),
    0 8px 24px color-mix(in srgb, var(--primary-600) 5%, transparent) !important;
}
