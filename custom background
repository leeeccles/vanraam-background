/* =================== UI TIDYING =================== */
.section.logo-section.workspace-navigation-logo {
  display: none !important;
}

.nested-section.home-section {
  margin-top: 8px !important;
}

.group-pic-container .type-icon {
  display: none !important;
}

/* =================== HOMEPAGE: GRADIENT BACKGROUND =================== */
/*
  Tint the homepage in the platform colour: near-white at the top, slightly
  deeper toward the bottom.
  Tune: the 2% / 6% mix percentages control how strong the tint is. Keep the
  gap between them small (3-5 points) or the gradient starts to band.
*/
.__view:has(#my-work-section) {
  position: relative !important;
  background: linear-gradient(
    to bottom,
    color-mix(in srgb, var(--primary-600) 2%, white) 0%,
    color-mix(in srgb, var(--primary-600) 6%, white) 100%
  ) !important;
  min-height: 100vh !important;
}

/* =================== HOMEPAGE: COLLABORATION PHOTO =================== */
/*
  Photo pinned to the viewport so it stays put while content scrolls.
  Tune:
    background-image     - swap the URL for any other photo
    background-size      - 75% of viewport width; raise to crop in tighter
    background-position  - left 70% = flush left, 70% down the frame
    opacity              - 0.10 is barely-there; 0.20 is roughly the ceiling
                           before it competes with text
    mask-image           - first gradient fades top/bottom, second fades out
                           to the right. Both must stay identical to the
                           -webkit- copies below or Safari drops the effect.
  Do not add `filter` here — it breaks position: fixed on some engines.
*/
.__view:has(#my-work-section)::before {
  content: '' !important;
  position: fixed !important;
  inset: 0 !important;
  background-image: url('https://www.vanraam.com/assets/img/92379/1696324349-studded-tires-van-raam-easy-rider-tricycle.jpg?auto=format&crop=focalpoint') !important;
  background-size: 75% auto !important;
  background-position: left 70% !important;
  background-repeat: no-repeat !important;
  opacity: 0.10 !important;
  mask-image:
    linear-gradient(to bottom, transparent 0%, black 28%, black 60%, transparent 100%),
    linear-gradient(to right, black 30%, transparent 75%) !important;
  -webkit-mask-image:
    linear-gradient(to bottom, transparent 0%, black 28%, black 60%, transparent 100%),
    linear-gradient(to right, black 30%, transparent 75%) !important;
  mask-composite: intersect !important;
  -webkit-mask-composite: source-in !important;
  z-index: 0 !important;
  pointer-events: none !important;
}

/* Required: lifts content above the photo layer. Leave as is. */
.__view:has(#my-work-section) > * {
  position: relative !important;
  z-index: 1 !important;
}

/* =================== MY WORK: SHADOW LIFT =================== */
/*
  Two-layer shadow: a tight one for edge definition, a wide one for lift.
  Tune the 8% / 5% alpha values together — raising both past ~15% reads as
  a drop shadow rather than a lift.
*/
#my-work-section {
  border-radius: 12px !important;
  box-shadow:
    0 2px 8px color-mix(in srgb, var(--primary-600) 8%, transparent),
    0 8px 24px color-mix(in srgb, var(--primary-600) 5%, transparent) !important;
}
